<?xml version="1.0" encoding="utf-8"?>
<!-- Filled in by build_store.py: {{NAME}} {{PUBLISHER}} {{PUBLISHER_DISPLAY_NAME}} {{DISPLAY_NAME}} come from identity.json,
     {{VERSION}} from addon\KeyParse\KeyParse.toc (0.6.13 -> 0.6.13.0). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="{{NAME}}" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{{DISPLAY_NAME}}</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Fetches Warcraft Logs Mythic+ parses for the KeyParse World of Warcraft addon.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="KeyParseCompanion" Executable="KeyParseCompanion.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{{DISPLAY_NAME}}"
        Description="Fetches Warcraft Logs Mythic+ parses for the KeyParse World of Warcraft addon."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Start with Windows. Turned on after the first launch; the user switches it in Settings > Apps > Startup.
             KeyParseCompanionStartup.exe is a copy of the main exe: that name makes it start hidden in the tray. -->
        <desktop:Extension Category="windows.startupTask" Executable="KeyParseCompanionStartup.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="KeyParseCompanionStartup" Enabled="true" DisplayName="{{DISPLAY_NAME}}" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
